# Порт, на котором поднимется сервер
PORT=5000

# Строка подключения к MongoDB (Atlas или локальная)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio

# Секреты для подписи JWT. Обязательно свои случайные строки,
# например: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# URL(ы) фронтенда, разрешённые в CORS. Через запятую, без пробелов важны только сами значения.
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# SMTP для писем (сброс пароля, уведомления о фидбеке)
SMTP_URL=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_LOGIN=your_smtp_login
SMTP_PASSWORD=your_smtp_password

# Почта, на которую по умолчанию будут приходить уведомления о новых
# сообщениях с формы обратной связи (можно переопределить в /admin/settings)
ADMIN_EMAIL=you@example.com

# production включает secure-куки и sameSite=strict
NODE_ENV=development

ADMIN_USERNAME=portfolio_admin
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_PASSWORD=change_this_strong_password